
import test from "node:test";
import assert from "node:assert/strict";
import { finalAction, tradePlan } from "../src/trade-plan.js";

const market = {
  close: 1.12390,
  atr14: 0.000374
};

test("BUY with H1 WAIT produces no plan and final action NO TRADE", () => {
  const plan = tradePlan("BUY", market, { status: "WAIT" });

  assert.equal(plan, null);
  assert.equal(finalAction("BUY", plan), "NO TRADE");
});

test("SELL with H1 WAIT produces no plan and final action NO TRADE", () => {
  const plan = tradePlan("SELL", market, { status: "WAIT" });

  assert.equal(plan, null);
  assert.equal(finalAction("SELL", plan), "NO TRADE");
});

test("BUY with H1 ALIGNED creates a 1:2 plan", () => {
  const plan = tradePlan("BUY", market, { status: "H1 ALIGNED" });

  assert.ok(plan);
  assert.equal(plan.entry, market.close);
  assert.ok(plan.stopLoss < plan.entry);
  assert.ok(plan.takeProfit > plan.entry);
  assert.equal(plan.riskReward, "1:2");
  assert.equal(finalAction("BUY", plan), "BUY");
});

test("SELL with H1 ALIGNED creates a 1:2 plan", () => {
  const plan = tradePlan("SELL", market, { status: "H1 ALIGNED" });

  assert.ok(plan);
  assert.equal(plan.entry, market.close);
  assert.ok(plan.stopLoss > plan.entry);
  assert.ok(plan.takeProfit < plan.entry);
  assert.equal(plan.riskReward, "1:2");
  assert.equal(finalAction("SELL", plan), "SELL");
});

test("HOLD never creates a trade plan", () => {
  const plan = tradePlan("HOLD", market, { status: "H1 ALIGNED" });

  assert.equal(plan, null);
  assert.equal(finalAction("HOLD", plan), "NO TRADE");
});

test("Invalid ATR or missing H1 confirmation never creates a plan", () => {
  assert.equal(
    tradePlan("BUY", { ...market, atr14: 0 }, { status: "H1 ALIGNED" }),
    null
  );

  assert.equal(
    tradePlan("BUY", { ...market, atr14: Number.NaN }, { status: "H1 ALIGNED" }),
    null
  );

  assert.equal(
    tradePlan("BUY", market, null),
    null
  );
});
